# Live mode requires an authorized SheerID API application and published program.
SHEERFLOW_MODE=live
SHEERID_CLIENT_ID=replace-with-your-client-id
SHEERID_CLIENT_SECRET=replace-with-your-client-secret
SHEERID_PROGRAM_ID=replace-with-your-24-character-program-id

# Use a unique local-only password with at least 20 characters.
SHEERFLOW_DASHBOARD_PASSWORD=replace-with-a-unique-password-of-20-characters-or-more
SHEERFLOW_HOST=127.0.0.1
SHEERFLOW_PORT=8787
SHEERFLOW_CONCURRENCY=2
SHEERFLOW_POLL_INTERVAL_MS=5000
SHEERFLOW_MAX_DOCUMENT_BYTES=20971520
SHEERFLOW_PROGRAM_LABEL=Authorized program

# For an offline walkthrough, set SHEERFLOW_MODE=demo and leave the SHEERID_* values unused.
